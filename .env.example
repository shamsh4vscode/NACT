POSTGRES_DB=nact
POSTGRES_USER=nact
POSTGRES_PASSWORD=nact-dev-password
DATABASE_URL=postgresql+psycopg://nact:nact-dev-password@postgres:5432/nact
REDIS_URL=redis://redis:6379/0
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=nact-root-token
KEYCLOAK_ADMIN=nact-admin
KEYCLOAK_ADMIN_PASSWORD=keycloak-dev-password
SESSION_SECRET=replace-this-with-a-long-random-secret-for-local-development
SESSION_COOKIE_SECURE=false
NACT_DEVICE_MODE=simulated
KEYCLOAK_PUBLIC_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000
FRONTEND_ORIGIN_REGEX=https://[a-z0-9-]+-3000\.app\.github\.dev
NEXT_PUBLIC_API_URL=http://localhost:8000
